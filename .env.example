# Settings of the GMan server: copy to .env next to compose.yaml and change what you need, then
#   docker compose up --build -d
# The values below are the defaults used when a variable is missing.

# --- Ports on the host ---------------------------------------------------------------------------
# Portal, API (/api/) and Grafana (/grafana/); other servers send inventory here.
GMAN_PORT=8080
GMAN_BIND_ADDRESS=0.0.0.0
# Metrics from the Collectors of other servers (OTLP gRPC and HTTP).
GMAN_OTLP_PORT=4317
GMAN_OTLP_HTTP_PORT=4318
GMAN_OTLP_BIND_ADDRESS=0.0.0.0
# Published on 127.0.0.1 only.
GMAN_PROMETHEUS_PORT=9090
GMAN_ALERTMANAGER_PORT=9093
GMAN_GRAFANA_PORT=3000

# --- Metrics -------------------------------------------------------------------------------------
# Seconds between metric points: Collectors, DCGM, Prometheus scraping and alert rules, portal refresh.
# Set the same value on connected hosts (deploy/host/.env).
GMAN_METRICS_INTERVAL=5

# --- NVIDIA GPUs of this server ------------------------------------------------------------------
# Needs the NVIDIA driver and NVIDIA Container Toolkit: GPUs, which container holds them, DCGM metrics.
#COMPOSE_FILE=compose.yaml:deploy/compose.nvidia.yaml

# --- This server in the portal -------------------------------------------------------------------
GMAN_SOURCE_ID=gman-server
# Address shown with its services; empty shows the address of the agent's container.
GMAN_HOST_IP=

# --- Passwords -----------------------------------------------------------------------------------
# Set before the first start: PostgreSQL keeps the password its volume was created with,
# Grafana keeps the admin password of its first start.
POSTGRES_PASSWORD=gman
GRAFANA_ADMIN_PASSWORD=admin

# --- Links ---------------------------------------------------------------------------------------
# Grafana as the browser sees it (the portal proxies it under /grafana/).
GMAN_GRAFANA_URL=/grafana
# Portal address in alert runbook links; default http://127.0.0.1:<GMAN_PORT>.
#GMAN_PORTAL_URL=http://gman.example.org:8080
# Alertmanager address in notification links; default http://127.0.0.1:<GMAN_ALERTMANAGER_PORT>.
#GMAN_ALERTMANAGER_URL=
# Grafana root URL; default derived from the request, served under /grafana/.
#GMAN_GRAFANA_ROOT_URL=

# --- Splunk links on the service card (README, «Splunk»); empty URL hides them ------------------
GMAN_SPLUNK_URL=
GMAN_SPLUNK_SEARCH=
GMAN_SPLUNK_INDEXES=

# --- Alert receivers (README, «Алерты»); empty = alerts only in the portal and Alertmanager ------
GMAN_ALERT_WEBHOOK_URL=
GMAN_ALERT_HEARTBEAT_URL=
GMAN_ALERT_EMAIL_TO=
GMAN_ALERT_EMAIL_FROM=
GMAN_ALERT_SMTP_SMARTHOST=
GMAN_ALERT_SMTP_USERNAME=
GMAN_ALERT_SMTP_PASSWORD=
GMAN_ALERT_SMTP_REQUIRE_TLS=true
