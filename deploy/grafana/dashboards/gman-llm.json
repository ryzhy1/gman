  {
   "type": "timeseries",
   "title": "Время до первого токена (TTFT)",
   "description": "Перцентили за интервал графика. Растет с очередью и длиной промпта.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds_bucket{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p50 {{model_name}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds_bucket{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p95 {{model_name}}"
