    },
    "definition": "label_values(k8s_node_cpu_usage{k8s_cluster_name=~\"$cluster\"}, host_id)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "allValue": ".*"
   },
   {
