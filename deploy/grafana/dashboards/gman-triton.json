     "legendFormat": "p95 {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (gman_service, model, le) (rate(${histogram}_bucket{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p99 {{gman_service}} {{model}}"
