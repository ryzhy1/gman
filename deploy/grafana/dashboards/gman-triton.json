  {
   "type": "timeseries",
   "title": "$histogram",
   "description": "Перцентили по бакетам и среднее (sum/count) за интервал графика по сервису и модели.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
