{
 "uid": "gman-triton",
 "title": "GMan · Triton",
 "description": "Серверы NVIDIA Triton Inference Server: сводка по запросам, задержкам, очереди, батчингу и GPU, затем все метрики nv_*, которые есть в Prometheus, без списка имен.",
 "tags": [
  "gman"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Сервис",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"nv_.+\"}, gman_service)",
     "refId": "service"
    },
    "definition": "label_values({__name__=~\"nv_.+\"}, gman_service)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "model",
    "label": "Модель",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"nv_.+\", gman_service=~\"$service\"}, model)",
     "refId": "model"
    },
    "definition": "label_values({__name__=~\"nv_.+\", gman_service=~\"$service\"}, model)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "gauge",
    "label": "Gauges",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(nv_.+)",
     "refId": "gauge"
    },
    "definition": "metrics(nv_.+)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "regex": "/^(?!.*_(?:total|bucket|sum|count|created|info)$)(nv_.+)$/"
   },
   {
    "name": "counter",
    "label": "Счетчики",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(nv_.+_total)",
     "refId": "counter"
    },
    "definition": "metrics(nv_.+_total)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "histogram",
    "label": "Гистограммы",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(nv_.+_bucket)",
     "refId": "histogram"
    },
    "definition": "metrics(nv_.+_bucket)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "regex": "/^(nv_.+)_bucket$/"
   }
  ]
 },
 "links": [
  {
   "title": "Дашборды GMan",
   "type": "dashboards",
   "tags": [
    "gman"
   ],
   "asDropdown": false,
   "keepTime": true,
   "includeVars": false,
   "targetBlank": false,
   "icon": "external link"
  }
 ],
 "panels": [
  {
   "type": "row",
   "title": "Серверы и модели",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "table",
   "title": "Серверы",
   "description": "Все серверы Triton, которые опрашивают Collector-ы, и отвечает ли их /metrics.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "—"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Состояние"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "отвечает",
            "color": "green"
           },
           "0": {
            "text": "не отвечает",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (gman_service, gman_environment, host_id, container_name, namespace, pod, exported_instance) (up{job=\"otel\", exported_job=\"triton\", gman_service=~\"$service\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "Состояние"
      }
     }
    }
   ],
   "gridPos": {
    "x": 0,
    "w": 12,
    "h": 8,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "table",
   "title": "Модели",
   "description": "Модели (и версии) по сервисам и число реплик, которые сейчас отдают метрики.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "—"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "count by (gman_service, gman_environment, model, version) (group by (gman_service, gman_environment, model, version, host_id, container_name, pod) ({__name__=~\"nv_.+\", model!=\"\", gman_service=~\"$service\", model=~\"$model\"}))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "Реплик"
      }
     }
    }
   ],
   "gridPos": {
    "x": 12,
    "w": 12,
    "h": 8,
    "y": 1
   },
   "id": 3
  },
  {
   "type": "row",
   "title": "Сводка",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 9
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Запросы/с",
   "description": "Успешные и неуспешные запросы инференса в секунду по моделям.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "успешно {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (gman_service, model, reason) (rate(nv_inference_request_failure_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "ошибка {{reason}} {{gman_service}} {{model}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "w": 8,
    "h": 8,
    "y": 10
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Среднее время запроса по фазам",
   "description": "Накопленная длительность (мкс) / успешные запросы за интервал: весь запрос, ожидание в очереди, подготовка входа, инференс, выдача результата.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     },
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (gman_service, model) (rate(nv_inference_request_duration_us_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / 1000 / sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "весь запрос {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "sum by (gman_service, model) (rate(nv_inference_queue_duration_us_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / 1000 / sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "очередь {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "sum by (gman_service, model) (rate(nv_inference_compute_input_duration_us_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / 1000 / sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "вход {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "sum by (gman_service, model) (rate(nv_inference_compute_infer_duration_us_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / 1000 / sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "инференс {{gman_service}} {{model}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "E",
     "expr": "sum by (gman_service, model) (rate(nv_inference_compute_output_duration_us_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / 1000 / sum by (gman_service, model) (rate(nv_inference_request_success_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "выход {{gman_service}} {{model}}"
    }
   ],
   "gridPos": {
    "x": 8,
    "w": 8,
    "h": 8,
    "y": 10
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Запросов в очереди",
   "description": "nv_inference_pending_request_count: запросы, принятые сервером и еще не отданные на исполнение.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
