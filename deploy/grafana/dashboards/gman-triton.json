     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (gman_service, model, le) (rate(${histogram}_bucket{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p50 {{gman_service}} {{model}}"
