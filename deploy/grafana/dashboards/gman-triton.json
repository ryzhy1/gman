    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (gman_service, model) (nv_inference_pending_request_count{gman_service=~\"$service\", model=~\"$model\"})",
     "legendFormat": "{{gman_service}} {{model}}"
    }
   ],
   "gridPos": {
    "x": 16,
    "w": 8,
    "h": 8,
    "y": 10
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Батчинг: инференсов на исполнение",
   "description": "nv_inference_count / nv_inference_exec_count: сколько запросов в среднем объединяется в один запуск модели (1 — батчинг не работает).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (gman_service, model) (rate(nv_inference_count_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / sum by (gman_service, model) (rate(nv_inference_exec_count_total{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "{{gman_service}} {{model}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "w": 8,
    "h": 8,
    "y": 18
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Загрузка GPU (по данным Triton)",
   "description": "nv_gpu_utilization по GPU сервера.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     },
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
