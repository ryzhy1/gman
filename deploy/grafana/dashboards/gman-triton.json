     },
     "refId": "D",
     "expr": "sum by (gman_service, model) (rate(${histogram}_sum{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval])) / sum by (gman_service, model) (rate(${histogram}_count{gman_service=~\"$service\", model=~\"$model\"}[$__rate_interval]))",
