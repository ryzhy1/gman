{
 "uid": "gman-service",
 "title": "GMan · Сервис",
 "description": "Ресурсы контейнеров сервиса (Docker и Kubernetes) по меткам gman.service/gman.environment.",
 "tags": [
  "gman"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Сервис",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"container_memory_usage_total_bytes|container_memory_working_set_bytes\"}, gman_service)",
     "refId": "v"
    },
    "definition": "label_values({__name__=~\"container_memory_usage_total_bytes|container_memory_working_set_bytes\"}, gman_service)",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false
   },
   {
    "name": "environment",
    "label": "Окружение",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"container_memory_usage_total_bytes|container_memory_working_set_bytes\",gman_service=\"$service\"}, gman_environment)",
     "refId": "v"
    },
    "definition": "label_values({__name__=~\"container_memory_usage_total_bytes|container_memory_working_set_bytes\",gman_service=\"$service\"}, gman_environment)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "allValue": ".*"
   }
  ]
 },
