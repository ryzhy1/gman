     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "max by (UUID) (DCGM_FI_DEV_XID_ERRORS{host_id=\"$host\", UUID=~\"$gpu\"})",
     "legendFormat": "XID {{UUID}}"
    }
