     },
     "refId": "A",
     "expr": "max by (UUID) (increase(DCGM_FI_DEV_ECC_DBE_AGG_TOTAL_total{host_id=\"$host\", UUID=~\"$gpu\"}[24h])) or max by (UUID) (label_replace(increase(nvidia_smi_ecc_errors_uncorrected_aggregate_total{host_id=\"$host\"}[24h]), \"UUID\", \"GPU-$1\", \"uuid\", \"(?:GPU-)?(.+)\"))",
     "legendFormat": "ECC {{UUID}}"
