{
 "uid": "gman-llm-all",
 "title": "GMan · vLLM · все метрики",
 "description": "Все метрики vllm:*, которые есть в Prometheus, без списка имен: панели строятся по найденным метрикам, поэтому новые метрики новых версий vLLM появляются сами. Сводка — «GMan · LLM».",
 "tags": [
  "gman"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Сервис",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"vllm:.+\"}, gman_service)",
     "refId": "service"
    },
    "definition": "label_values({__name__=~\"vllm:.+\"}, gman_service)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "model",
    "label": "Модель",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values({__name__=~\"vllm:.+\", gman_service=~\"$service\"}, model_name)",
     "refId": "model"
    },
    "definition": "label_values({__name__=~\"vllm:.+\", gman_service=~\"$service\"}, model_name)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "gauge",
    "label": "Gauges",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(vllm:.+)",
     "refId": "gauge"
    },
    "definition": "metrics(vllm:.+)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "regex": "/^(?!.*_(?:total|bucket|sum|count|created|info)$)(vllm:.+)$/"
   },
   {
    "name": "counter",
    "label": "Счетчики",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(vllm:.+_total)",
     "refId": "counter"
    },
    "definition": "metrics(vllm:.+_total)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "histogram",
    "label": "Гистограммы",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "metrics(vllm:.+_bucket)",
     "refId": "histogram"
    },
    "definition": "metrics(vllm:.+_bucket)",
    "refresh": 2,
    "sort": 1,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "regex": "/^(vllm:.+)_bucket$/"
   }
  ]
 },
 "links": [
  {
   "title": "Дашборды GMan",
   "type": "dashboards",
   "tags": [
    "gman"
   ],
   "asDropdown": false,
   "keepTime": true,
   "includeVars": false,
   "targetBlank": false,
   "icon": "external link"
  }
 ],
 "panels": [
  {
   "type": "row",
   "title": "Серверы и модели",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "table",
   "title": "Серверы",
   "description": "Все серверы vLLM, которые опрашивают Collector-ы, и отвечает ли их /metrics.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "—"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Состояние"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "отвечает",
            "color": "green"
           },
           "0": {
            "text": "не отвечает",
            "color": "red"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max by (gman_service, gman_environment, host_id, container_name, namespace, pod, exported_instance) (up{job=\"otel\", exported_job=\"vllm\", gman_service=~\"$service\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "Состояние"
      }
     }
    }
   ],
   "gridPos": {
    "x": 0,
    "w": 12,
    "h": 8,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "table",
   "title": "Модели",
   "description": "Модели (--served-model-name) по сервисам и число реплик, которые сейчас отдают метрики.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "—"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "count by (gman_service, gman_environment, model_name) (group by (gman_service, gman_environment, model_name, host_id, container_name, pod) ({__name__=~\"vllm:.+\", model_name!=\"\", gman_service=~\"$service\", model_name=~\"$model\"}))",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "Реплик"
      }
     }
    }
   ],
   "gridPos": {
    "x": 12,
    "w": 12,
    "h": 8,
    "y": 1
   },
   "id": 3
  },
  {
   "type": "table",
   "title": "Конфигурация серверов (info-метрики)",
   "description": "Все метрики vllm:*_info как есть: параметры, которые сервер публикует метками.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "—"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "{__name__=~\"vllm:.+_info\", gman_service=~\"$service\", model_name=~\"$model\"}",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      },
      "renameByName": {}
     }
    }
   ],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 8,
    "y": 9
   },
   "id": 4
  },
  {
   "type": "row",
   "title": "Текущие значения (gauges)",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 17
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "$gauge",
   "description": "Значение как экспортирует сервер, каждая серия отдельно.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max without (job, instance, exported_job, exported_instance, otel_scope_name, otel_scope_version, server_address, server_port, service_instance_id, service_name, url_scheme) ($gauge{gman_service=~\"$service\", model_name=~\"$model\"})",
     "legendFormat": "__auto"
    }
   ],
   "repeat": "gauge",
   "repeatDirection": "h",
   "maxPerRow": 3,
   "gridPos": {
    "x": 0,
    "w": 8,
    "h": 8,
    "y": 18
   },
   "id": 6
  },
  {
   "type": "row",
   "title": "Счетчики: скорость в секунду",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 26
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "$counter",
   "description": "rate() за интервал графика, каждая серия отдельно.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum without (job, instance, exported_job, exported_instance, otel_scope_name, otel_scope_version, server_address, server_port, service_instance_id, service_name, url_scheme) (rate($counter{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "__auto"
    }
   ],
   "repeat": "counter",
   "repeatDirection": "h",
   "maxPerRow": 3,
   "gridPos": {
    "x": 0,
    "w": 8,
    "h": 8,
    "y": 27
   },
   "id": 8
  },
  {
   "type": "row",
   "title": "Гистограммы: перцентили и среднее",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "x": 0,
    "w": 24,
    "h": 1,
    "y": 35
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "$histogram",
   "description": "Перцентили по бакетам и среднее (sum/count) за интервал графика по сервису и модели.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 5,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never",
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (gman_service, model_name, le) (rate(${histogram}_bucket{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p50 {{gman_service}} {{model_name}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (gman_service, model_name, le) (rate(${histogram}_bucket{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p95 {{gman_service}} {{model_name}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (gman_service, model_name, le) (rate(${histogram}_bucket{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p99 {{gman_service}} {{model_name}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "D",
     "expr": "sum by (gman_service, model_name) (rate(${histogram}_sum{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval])) / sum by (gman_service, model_name) (rate(${histogram}_count{gman_service=~\"$service\", model_name=~\"$model\"}[$__rate_interval]))",
     "legendFormat": "среднее {{gman_service}} {{model_name}}"
    }
   ],
   "repeat": "histogram",
   "repeatDirection": "h",
   "maxPerRow": 2,
   "gridPos": {
    "x": 0,
    "w": 12,
    "h": 8,
    "y": 36
   },
   "id": 10
  }
 ]
}
