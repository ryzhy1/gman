# Copy to .env in deploy/host on the host and fill in; then, from deploy/host:
#   docker compose up -d --build

# Address of the GMan server (IP or DNS name). Required.
GMAN_SERVER=10.0.0.5
# Unique name of this host in GMan, e.g. its hostname. Required.
GMAN_SOURCE_ID=server-02

# Ports of the GMan server, if changed there (GMAN_PORT and GMAN_OTLP_PORT in its .env).
#GMAN_PORT=8080
#GMAN_OTLP_PORT=4317

# Seconds between metric points; the same value as GMAN_METRICS_INTERVAL of the GMan server.
#GMAN_METRICS_INTERVAL=5

# Address shown in the portal; by default the address of this host's default route.
#GMAN_HOST_IP=

# NVIDIA GPUs (needs the NVIDIA driver and NVIDIA Container Toolkit): GPUs, which container holds them and their
# metrics via DCGM Exporter. Uncomment on GPU hosts.
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
