# Node Collector (otelcol-contrib) for a Docker host, config deploy/otel-agent.example.yaml.
# Install: binary /usr/bin/otelcol-contrib (the release .deb/.rpm; disable its own
# otelcol-contrib.service), config /etc/gman/otel-agent.yaml, environment /etc/gman/otelcol.env,
# client certificate /etc/gman/{ca.pem,client.pem,client-key.pem} readable by group gman-otel.
# Persistent sending queue (file_storage): /var/lib/gman-otelcol, created by StateDirectory below.
[Unit]
Description=GMan node OpenTelemetry Collector
Wants=network-online.target
After=network-online.target docker.service

[Service]
EnvironmentFile=/etc/gman/otelcol.env
ExecStart=/usr/bin/otelcol-contrib --config=/etc/gman/otel-agent.yaml
# Queue directory for file_storage (GMAN_OTEL_STORAGE_DIR default): systemd creates it owned by gman-otel
# with mode 0700 and keeps it across restarts and upgrades. It is the only writable path under ProtectSystem=strict
# (StateDirectory implies it; ReadWritePaths states it). Another GMAN_OTEL_STORAGE_DIR needs its own ReadWritePaths.
StateDirectory=gman-otelcol
StateDirectoryMode=0700
ReadWritePaths=/var/lib/gman-otelcol
Restart=on-failure
RestartSec=5s
User=gman-otel
Group=gman-otel
# docker_stats reads the Docker socket (root-equivalent).
SupplementaryGroups=docker
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only rather than hidden so the filesystem scraper can stat /home mounts.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
