# /etc/gman/otelcol.env — root:root 0644 (no secrets: the client key is a file).
# Must equal GMAN_SOURCE_ID of the inventory agent on this host.
GMAN_HOST_ID=server-01
# Central gateway OTLP gRPC (mTLS); the name must be in the gateway certificate SAN.
OTEL_GATEWAY=gman.example.org:4317
#DOCKER_SOCKET=unix:///var/run/docker.sock
# Persistent sending queue; another path also needs ReadWritePaths= in gman-otelcol.service.
#GMAN_OTEL_STORAGE_DIR=/var/lib/gman-otelcol
