# /etc/gman/agent.env — root:root 0644.
GMAN_URL=http://gman.example.org:8080
GMAN_SOURCE_ID=server-01
GMAN_RUNTIME=docker
# With an HTTPS GMAN_URL and the pilot CA (production override), trust it (Python uses OpenSSL default paths):
#SSL_CERT_FILE=/etc/gman/ca.pem
# For --runtime kubernetes: read-only kubeconfig, see deploy/kubernetes-rbac.yaml.
#KUBECONFIG=/etc/gman/kubeconfig
# For GMAN_RUNTIME=kubernetes-node on a GPU node (GMAN_SOURCE_ID=<cluster>.<node>): the node name as in
# Kubernetes and the cluster agent's source ID. Needs list pods (deploy/gpu-attribution-k8s.yaml ClusterRole).
#NODE_NAME=gpu-1
#GMAN_CLUSTER=cluster-01
